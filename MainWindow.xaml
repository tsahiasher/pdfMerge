<Window x:Class="pdfMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pdfMerge"
        mc:Ignorable="d"
        Title="PDF Merge &amp; Page Manager" Height="780" Width="1360"
        MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Icon="pdfMerge.ico"
        Background="#0F172A" Foreground="#F8FAFC"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Modern ScrollBar Style (window-scoped to avoid global side effects) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Header -->
            <RowDefinition Height="*"/>
            <!-- Main Content Area -->
            <RowDefinition Height="Auto"/>
            <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Transparent App Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="Transparent" Margin="0,0,10,0">
                        <Image Source="pdfMerge.ico" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PDF Merger &amp; Page Manager" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Top Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnOpenFiles_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂 " FontSize="14"/>
                            <TextBlock Text="Add Files"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRevert" Click="BtnRevert_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,10,0" ToolTip="Undo all changes and reload original PDFs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="13"/>
                            <TextBlock Text="Revert All"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnClearAll_Click" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0" ToolTip="Clear all loaded files and pages">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑 " FontSize="13"/>
                            <TextBlock Text="Clear All"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSplit" Click="BtnSplit_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,10,0" ToolTip="Split PDF into multiple custom page ranges">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✂️ " FontSize="13"/>
                            <TextBlock Text="Split PDF"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPrint" Click="BtnPrint_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,10,0" ToolTip="Print document or selected pages with color, page range, and duplex options">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️ " FontSize="13"/>
                            <TextBlock Text="Print"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExportSelectedImage" Click="BtnExportSelectedImage_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,10,0" ToolTip="Export selected pages as high-resolution PNG or JPG images">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼 " FontSize="13"/>
                            <TextBlock Text="Export Images"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSaveSelected" Click="BtnSaveSelected_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,10,0" ToolTip="Save only selected pages to a new PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="13"/>
                            <TextBlock Text="Save Selected"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMergeSave" Click="BtnMergeSave_Click" Style="{StaticResource SuccessButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="14"/>
                            <TextBlock Text="Merge &amp; Save All"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY CONTAINER -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <!-- Left File Manager Panel -->
                <ColumnDefinition Width="*"/>
                <!-- Right Page Grid Canvas -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: FILE LIST -->
            <Border Grid.Column="0" Background="#182232" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- List Header -->
                        <RowDefinition Height="*"/>
                        <!-- File List -->
                    </Grid.RowDefinitions>

                    <!-- FILE LIST HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="PDF Source Files" FontWeight="Bold" FontSize="14" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFileCount" Text="0 files" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- FILE LISTBOX -->
                    <ListBox x:Name="LstFiles" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="{Binding DocumentColorHex}" BorderThickness="2" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Order Badge -->
                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="{Binding DocumentColorHex}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Order}" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- File Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PageCount, StringFormat='{}{0} pages'}" FontSize="11" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Reorder & Remove Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Click="BtnMoveFileUp_Click" Style="{StaticResource IconButtonLessStyle}" Padding="5,2" Margin="0,0,3,0" ToolTip="Move Up">
                                                <TextBlock Text="▲" FontSize="10"/>
                                            </Button>
                                            <Button Click="BtnMoveFileDown_Click" Style="{StaticResource IconButtonLessStyle}" Padding="5,2" Margin="0,0,3,0" ToolTip="Move Down">
                                                <TextBlock Text="▼" FontSize="10"/>
                                            </Button>
                                            <Button Click="BtnRemoveFile_Click" Style="{StaticResource DangerButtonStyle}" Padding="5,2" ToolTip="Remove File">
                                                <TextBlock Text="✕" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: PAGE GALLERY & CONTROLS -->
            <Grid Grid.Column="1" Background="#0F172A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Toolbar & Controls -->
                    <RowDefinition Height="*"/>
                    <!-- Page Thumbnails Grid -->
                </Grid.RowDefinitions>

                <!-- GALLERY SUBHEADER & TOOLBAR -->
                <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Page Badges -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#334155" CornerRadius="10" Padding="8,2" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtPageCountBadge" Text="0 Pages" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="TxtSelectedCountBadge" Text="(0 selected)" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ZOOM SLIDER & BATCH ACTION BUTTONS -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- Zoom Size Slider with Magnifying Glass Vector Lens (- / + INSIDE) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <!-- Zoom Out: Magnifying Glass with MINUS (-) INSIDE Lens -->
                                <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Zoom Out">
                                    <Line X1="3" Y1="15" X2="8" Y2="10" Stroke="#94A3B8" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                    <Ellipse Width="12" Height="12" Stroke="#38BDF8" StrokeThickness="1.6" Fill="#182232" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <Rectangle Width="6" Height="1.8" Fill="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5.1,3,0"/>
                                </Grid>

                                <Slider x:Name="SldZoom" Minimum="1" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Width="90" VerticalAlignment="Center" ValueChanged="SldZoom_ValueChanged" ToolTip="Thumbnail Zoom Level (1-4)"/>

                                <!-- Zoom In: Magnifying Glass with PLUS (+) INSIDE Lens -->
                                <Grid Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Zoom In">
                                    <Line X1="3" Y1="15" X2="8" Y2="10" Stroke="#94A3B8" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                    <Ellipse Width="12" Height="12" Stroke="#38BDF8" StrokeThickness="1.6" Fill="#182232" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <Rectangle Width="6" Height="1.8" Fill="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5.1,3,0"/>
                                    <Rectangle Width="1.8" Height="6" Fill="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5.1,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Overlapping Double Check Select All & X Deselect Buttons -->
                            <Button Click="BtnSelectAllPages_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,6,0" ToolTip="Select All Pages (Ctrl+A)">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="4,-2,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Select All" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnDeselectAllPages_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,12,0" ToolTip="Deselect All Pages">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕ " FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="Deselect" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnRotateSelectedCW" Click="BtnRotateSelectedCW_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,6,0" ToolTip="Rotate Selected Pages Clockwise (Lossless)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻ " FontSize="12"/>
                                    <TextBlock Text="Rotate CW"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnRotateSelectedCCW" Click="BtnRotateSelectedCCW_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,12,0" ToolTip="Rotate Selected Pages Counter-Clockwise (Lossless)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺ " FontSize="12"/>
                                    <TextBlock Text="Rotate CCW"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnDeleteSelected" Click="BtnDeleteSelected_Click" Style="{StaticResource DangerButtonStyle}" ToolTip="Delete Selected Pages">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑 " FontSize="12"/>
                                    <TextBlock Text="Delete Selected"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- EMPTY STATE PLACEHOLDER -->
                <StackPanel x:Name="PnlEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📑" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No PDF Pages Loaded" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click 'Add Files' to start." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- CONTAINER FOR LISTBOX & OVERLAY CANVAS -->
                <Grid Grid.Row="1" x:Name="GridGalleryContainer"
                      PreviewMouseLeftButtonDown="LstPages_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="LstPages_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="LstPages_PreviewMouseLeftButtonUp">
                    
                    <!-- PAGE THUMBNAILS EXTENDED SELECTION LISTBOX WITH LIVE DRAG REFLOW -->
                    <ListBox x:Name="LstPages" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended" Padding="16"
                             SelectionChanged="LstPages_SelectionChanged"
                             AllowDrop="True"
                             DragOver="LstPages_DragOver"
                             DragLeave="LstPages_DragLeave"
                             Drop="LstPages_Drop"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="MouseMove" Handler="ListBoxItem_MouseMove"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- THUMBNAIL CARD BORDER (Color distinguishes source document) -->
                                <Border x:Name="cardBorder" Width="{Binding CardWidth}" Height="{Binding CardHeight}" Background="#1E293B" BorderBrush="{Binding DocumentColorHex}" BorderThickness="3" CornerRadius="10" Cursor="Hand">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Card Header -->
                                            <RowDefinition Height="*"/>
                                            <!-- Thumbnail Area -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Card Toolbar -->
                                        </Grid.RowDefinitions>

                                        <!-- CARD HEADER -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- TOP-LEFT SELECTION CHECKBOX -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" ToolTip="Select Page"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <!-- Original page number badge -->
                                                <Border x:Name="pageBadge" Background="{Binding DocumentColorHex}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding OriginalPageNumber, StringFormat='Orig. {0}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Source file badge -->
                                            <TextBlock Grid.Column="2" Text="{Binding SourceFileName}" FontSize="10" Foreground="{Binding DocumentColorHex}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="75" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding SourceFilePath}"/>
                                        </Grid>

                                        <!-- THUMBNAIL CONTAINER -->
                                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Margin="0,0,0,6" ClipToBounds="True">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Loading Text -->
                                                <TextBlock Text="Loading..." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Image Preview with RenderTransform Rotation -->
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" MaxHeight="{Binding ImageMaxHeight}" MaxWidth="{Binding ImageMaxWidth}">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="{Binding Rotation}"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <!-- CARD BOTTOM TOOLBAR -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Simple Current Output Page Number -->
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayPageNumber, StringFormat='P. {0}'}" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,0,0"/>

                                            <!-- Action Buttons: Rotate CCW, Rotate CW, Edit Sign, Delete -->
                                            <StackPanel Grid.Column="2" x:Name="PnlBottomActions" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                                <Button Click="BtnRotateCCW_Click" Style="{StaticResource IconButtonLessStyle}" Padding="6,3" Margin="0,0,3,0" ToolTip="Rotate -90° (CCW)">
                                                    <TextBlock Text="↺" FontSize="12"/>
                                                </Button>
                                                <Button Click="BtnRotateCW_Click" Style="{StaticResource IconButtonLessStyle}" Padding="6,3" Margin="0,0,3,0" ToolTip="Rotate +90° (CW)">
                                                    <TextBlock Text="↻" FontSize="12"/>
                                                </Button>
                                                <Button Click="BtnSignPage_Click" Style="{StaticResource IconButtonLessStyle}" Padding="6,3" Margin="0,0,3,0" ToolTip="Sign / Edit Page (Draw / Load Signature)">
                                                    <TextBlock Text="✏️" FontSize="11"/>
                                                </Button>
                                                <Button Click="BtnDeletePage_Click" Style="{StaticResource DangerButtonStyle}" Padding="6,3" ToolTip="Delete Page">
                                                    <TextBlock Text="🗑" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- Visual selection trigger bound directly to IsSelected model -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="cardBorder" Property="Background" Value="#0F2942"/>
                                        <Setter TargetName="cardBorder" Property="BorderThickness" Value="4.5"/>
                                    </DataTrigger>
                                    <!-- Hide card container from grid during dragging -->
                                    <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                        <Setter TargetName="cardBorder" Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                    <!-- Show Action Controls on Mouse Hover -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="PnlBottomActions" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- FLOATING LOW-OPACITY DRAG GHOST PREVIEW CANVAS SHOWING ACTUAL PAGE IMAGE -->
                    <Canvas x:Name="CnvDragGhost" IsHitTestVisible="False">
                        <Border x:Name="GhostCard" Width="190" Height="285" Background="#0F2942" BorderBrush="#0EA5E9" BorderThickness="2.5" CornerRadius="10" Opacity="0.65" Visibility="Collapsed">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Badge -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <Border Background="#10B981" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TxtGhostBadge" Text="Moving Page" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Actual Image Preview -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" ClipToBounds="True">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="GhostImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" MaxHeight="210" MaxWidth="165">
                                            <Image.RenderTransform>
                                                <RotateTransform x:Name="GhostRotateTransform" Angle="0"/>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Canvas>

                    <!-- OVERLAY CANVAS FOR RUBBER-BAND MARQUEE SELECTION RECTANGLE -->
                    <Canvas x:Name="CnvSelectionBox" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRectangle" Stroke="#0EA5E9" StrokeThickness="1.5" Fill="#330EA5E9" Visibility="Collapsed" RadiusX="3" RadiusY="3"/>
                    </Canvas>
                </Grid>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressStatus" Grid.Column="1" Height="14" IsIndeterminate="False" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

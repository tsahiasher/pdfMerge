<Window x:Class="pdfMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pdfMerge"
        mc:Ignorable="d"
        Title="PDF Merge &amp; Page Tools" Height="780" Width="1240"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Icon="pdfMerge.ico">

    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Success Button Style (Merge & Save) -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Icon Button Style -->
        <Style x:Key="IconButtonLessStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Header -->
            <RowDefinition Height="*"/>
            <!-- Main Content Area -->
            <RowDefinition Height="Auto"/>
            <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pdfMerge.ico" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PDF Merger &amp; Page Manager" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Drag &amp; drop to reorder pages, marquee select, rotate losslessly, and merge" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnOpenFiles_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂 " FontSize="14"/>
                            <TextBlock Text="Add PDF Files"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnClearAll_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑 " FontSize="13"/>
                            <TextBlock Text="Clear All"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMergeSave" Click="BtnMergeSave_Click" Style="{StaticResource SuccessButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="14"/>
                            <TextBlock Text="Merge &amp; Save PDF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY CONTAINER -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <!-- Left File Manager Panel -->
                <ColumnDefinition Width="*"/>
                <!-- Right Page Grid Canvas -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: FILE LIST & DRAG-DROP -->
            <Border Grid.Column="0" Background="#182232" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Drag Drop Target -->
                        <RowDefinition Height="Auto"/>
                        <!-- List Header -->
                        <RowDefinition Height="*"/>
                        <!-- File List -->
                    </Grid.RowDefinitions>

                    <!-- DRAG & DROP ZONE -->
                    <Border Grid.Row="0" Height="110" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="10" Margin="0,0,0,16" Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Drag &amp; Drop PDF Files Here" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="or click 'Add PDF Files' button" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- FILE LIST HEADER -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="PDF Source Files" FontWeight="Bold" FontSize="14" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFileCount" Text="0 files" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- FILE LISTBOX -->
                    <ListBox x:Name="LstFiles" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Order Badge -->
                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#0EA5E9" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Order}" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- File Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PageCount, StringFormat='{}{0} pages'}" FontSize="11" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Reorder & Remove Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Click="BtnMoveFileUp_Click" Style="{StaticResource IconButtonLessStyle}" Padding="5,2" Margin="0,0,3,0" ToolTip="Move Up">
                                                <TextBlock Text="▲" FontSize="10"/>
                                            </Button>
                                            <Button Click="BtnMoveFileDown_Click" Style="{StaticResource IconButtonLessStyle}" Padding="5,2" Margin="0,0,3,0" ToolTip="Move Down">
                                                <TextBlock Text="▼" FontSize="10"/>
                                            </Button>
                                            <Button Click="BtnRemoveFile_Click" Style="{StaticResource DangerButtonStyle}" Padding="5,2" ToolTip="Remove File">
                                                <TextBlock Text="✕" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: PAGE THUMBNAIL GALLERY & MULTI-SELECT TOOLBAR -->
            <Grid Grid.Column="1" Background="#0F172A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Toolbar & Batch Actions -->
                    <RowDefinition Height="*"/>
                    <!-- Page Thumbnails Grid with Visual Marker -->
                </Grid.RowDefinitions>

                <!-- GALLERY SUBHEADER & BATCH ACTIONS TOOLBAR -->
                <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Page Summary & Selection Status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Document Pages" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,0,10,0"/>
                            <Border Background="#334155" CornerRadius="10" Padding="8,2" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtPageCountBadge" Text="0 Pages" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="TxtSelectedCountBadge" Text="(0 selected)" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Selection & Batch Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Click="BtnSelectAllPages_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,6,0" ToolTip="Select All Pages (Ctrl+A)">
                                <TextBlock Text="Select All" FontSize="12"/>
                            </Button>
                            <Button Click="BtnDeselectAllPages_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,12,0" ToolTip="Deselect All Pages">
                                <TextBlock Text="Deselect" FontSize="12"/>
                            </Button>

                            <Button x:Name="BtnRotateSelectedCW" Click="BtnRotateSelectedCW_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,6,0" ToolTip="Rotate Selected Pages Clockwise (Lossless)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻ " FontSize="12"/>
                                    <TextBlock Text="Rotate Selected CW"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnRotateSelectedCCW" Click="BtnRotateSelectedCCW_Click" Style="{StaticResource IconButtonLessStyle}" Margin="0,0,12,0" ToolTip="Rotate Selected Pages Counter-Clockwise (Lossless)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺ " FontSize="12"/>
                                    <TextBlock Text="Rotate Selected CCW"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnDeleteSelected" Click="BtnDeleteSelected_Click" Style="{StaticResource DangerButtonStyle}" ToolTip="Delete Selected Pages">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑 " FontSize="12"/>
                                    <TextBlock Text="Delete Selected"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- EMPTY STATE PLACEHOLDER -->
                <StackPanel x:Name="PnlEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📑" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No PDF Pages Loaded" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drag &amp; drop PDF files onto the left panel or click 'Add PDF Files' to start." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- CONTAINER FOR LISTBOX & OVERLAY VISUAL INSERTION MARKER & MARQUEE SELECTION -->
                <Grid Grid.Row="1" x:Name="GridGalleryContainer"
                      PreviewMouseLeftButtonDown="LstPages_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="LstPages_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="LstPages_PreviewMouseLeftButtonUp">
                    
                    <!-- PAGE THUMBNAILS EXTENDED SELECTION LISTBOX WITH SMOOTH SCROLLING & DRAG-DROP -->
                    <ListBox x:Name="LstPages" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended" Padding="16"
                             SelectionChanged="LstPages_SelectionChanged"
                             AllowDrop="True"
                             DragOver="LstPages_DragOver"
                             DragLeave="LstPages_DragLeave"
                             Drop="LstPages_Drop"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="MouseMove" Handler="ListBoxItem_MouseMove"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- THUMBNAIL CARD BORDER -->
                                <Border x:Name="cardBorder" Width="205" Height="305" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="10" Cursor="Hand">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Card Header -->
                                            <RowDefinition Height="*"/>
                                            <!-- Thumbnail Area -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Card Toolbar -->
                                        </Grid.RowDefinitions>

                                        <!-- CARD HEADER -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Selection indicator / Page number badge -->
                                                <Border x:Name="pageBadge" Background="#0EA5E9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding DisplayPageNumber, StringFormat='Page {0}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <Border Background="#334155" CornerRadius="4" Padding="4,2">
                                                    <TextBlock Text="{Binding RotationText}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Source file badge -->
                                            <TextBlock Text="{Binding SourceFileName}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="75" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding SourceFilePath}"/>
                                        </Grid>

                                        <!-- THUMBNAIL CONTAINER -->
                                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Margin="0,0,0,6" ClipToBounds="True">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Loading Text -->
                                                <TextBlock Text="Loading..." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Image Preview with RenderTransform Rotation -->
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" MaxHeight="205" MaxWidth="175">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="{Binding Rotation}"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <!-- CARD BOTTOM TOOLBAR (Rotate CCW, Rotate CW, Delete) -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Rotate Buttons -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Click="BtnRotateCCW_Click" Style="{StaticResource IconButtonLessStyle}" Padding="8,4" Margin="0,0,4,0" ToolTip="Rotate -90° (CCW)">
                                                    <TextBlock Text="↺" FontSize="12"/>
                                                </Button>
                                                <Button Click="BtnRotateCW_Click" Style="{StaticResource IconButtonLessStyle}" Padding="8,4" ToolTip="Rotate +90° (CW)">
                                                    <TextBlock Text="↻" FontSize="12"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Delete Page Button -->
                                            <Button Grid.Column="1" Click="BtnDeletePage_Click" Style="{StaticResource DangerButtonStyle}" Padding="8,4" ToolTip="Delete Page">
                                                <TextBlock Text="🗑" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- Visual trigger for selected card -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                        <Setter TargetName="cardBorder" Property="Background" Value="#0F2942"/>
                                        <Setter TargetName="cardBorder" Property="BorderThickness" Value="2.5"/>
                                        <Setter TargetName="pageBadge" Property="Background" Value="#10B981"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- OVERLAY CANVAS FOR VISUAL DROP INSERTION LINE MARKER -->
                    <Canvas x:Name="CnvInsertionMarker" IsHitTestVisible="False">
                        <Border x:Name="InsertionMarker" Width="5" Height="305" Background="#0EA5E9" CornerRadius="2.5" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>

                    <!-- OVERLAY CANVAS FOR RUBBER-BAND MARQUEE SELECTION RECTANGLE -->
                    <Canvas x:Name="CnvSelectionBox" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRectangle" Stroke="#0EA5E9" StrokeThickness="1.5" Fill="#330EA5E9" Visibility="Collapsed" RadiusX="3" RadiusY="3"/>
                    </Canvas>
                </Grid>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressStatus" Grid.Column="1" Height="14" IsIndeterminate="False" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

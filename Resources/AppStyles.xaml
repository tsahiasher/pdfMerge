<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Named Color / Brush Resources (Rec #5)                      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DarkBgBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="MediumBgBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="#182232"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#475569"/>
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="PrimaryBluePressedBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessGreenHoverBrush" Color="#059669"/>
    <SolidColorBrush x:Key="SuccessGreenPressedBrush" Color="#047857"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerRedHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerRedPressedBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="LightFgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="MediumLightFgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="MediumFgBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="MutedFgBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="DimFgBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#38BDF8"/>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Modern ScrollBar Style                                      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Button Styles (Rec #6 — consolidated from 3 windows)       -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Global Default Button Style (keeps Arrow cursor) -->
    <Style TargetType="Button">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Primary Button (MainWindow) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBlueHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBluePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DimFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Bold Button (PrintPreview) -->
    <Style x:Key="PrimaryBoldButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBlueHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBluePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DimFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


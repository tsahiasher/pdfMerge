<Window x:Class="pdfMerge.Views.SplitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Split PDF Document" Height="820" Width="1060"
        MinHeight="720" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Icon="../pdfMerge.ico"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title Header -->
            <RowDefinition Height="*"/>
            <!-- Main Content Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="✂️ Split PDF Document" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Define output parts by adding custom page ranges or using quick split tools." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="10,4">
                    <TextBlock x:Name="TxtTotalPagesBadge" Text="12 Pages Available" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN BODY (LEFT CONFIG + RIGHT RANGES LIST) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: ADD RANGE & QUICK SPLIT TOOLS -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- ADD CUSTOM RANGE SECTION -->
                        <TextBlock Text="Add Page Range" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                        <!-- Custom Name Input -->
                        <TextBlock Text="Part Label / Name (Optional)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtPartName" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" ToolTip="Custom label for this split part (e.g. Chapter 1)"/>

                        <!-- Option A: Range Text Box -->
                        <TextBlock Text="Page Range (e.g. 1-3 or 1,3,5)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtRangeInput" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" ToolTip="Enter pages e.g. 1-3, 5, 7-10"/>

                        <!-- Option B: From / To Inputs -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="From Page" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtFromPage" Style="{StaticResource ModernTextBoxStyle}" Text="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="To Page" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtToPage" Style="{StaticResource ModernTextBoxStyle}" Text="1"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="BtnAddRange" Click="BtnAddRange_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="➕ " FontSize="12"/>
                                <TextBlock Text="Add Range to List" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#334155" Margin="0,0,0,12"/>

                        <!-- QUICK AUTO-SPLIT TOOLS -->
                        <TextBlock Text="Quick Split Presets" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                        <Button Click="BtnSplitSinglePages_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip="Create a separate 1-page PDF for every single page">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📄 " FontSize="12"/>
                                <TextBlock Text="Split Into Single Pages"/>
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Button Click="BtnSplitEveryN_Click" Style="{StaticResource SecondaryButtonStyle}" Grid.Column="0" ToolTip="Split document into parts of N pages each">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📊 " FontSize="12"/>
                                    <TextBlock Text="Split Every N Pages:"/>
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="TxtChunkSize" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="2" Margin="6,0,0,0" TextAlignment="Center" ToolTip="Number of pages per chunk"/>
                        </Grid>

                        <Button x:Name="BtnSplitSelectedOnly" Click="BtnSplitSelectedOnly_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" ToolTip="Create parts from selected workspace pages">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="☑️ " FontSize="12"/>
                                <TextBlock Text="Split Selected Pages Only"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL: CONFIGURED SPLIT PARTS LIST -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- LIST HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Configured Output Files" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#334155" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="TxtPartCountBadge" Text="0 Parts Configured" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- LIST OF SPLIT RANGES -->
                    <ListBox x:Name="LstSplitRanges" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon Badge -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#0EA5E9" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="📄" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,8,0"/>
                                                <Border Background="#334155" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding PageCount, StringFormat='{}{0} pages'}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PageSummaryText}" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Remove Button -->
                                        <Button Grid.Column="2" Click="BtnRemoveRange_Click" Style="{StaticResource DangerButtonStyle}" Padding="6,4" VerticalAlignment="Center" ToolTip="Remove range">
                                            <TextBlock Text="✕" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- EMPTY PLACEHOLDER TEXT -->
                    <Border x:Name="BdrEmptyState" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="✂️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No Output Parts Added Yet" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Use the left panel to define custom page ranges or click 'Split Into Single Pages' to split every page." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" MaxWidth="360"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER ACTION BAR -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Button Click="BtnClearRanges_Click" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑 " FontSize="12"/>
                        <TextBlock Text="Clear All Ranges"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="16,8">
                        <TextBlock Text="Cancel"/>
                    </Button>

                    <Button x:Name="BtnSplitSave" Click="BtnSplitSave_Click" Style="{StaticResource SuccessBoldButtonStyle}" Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✂️ " FontSize="13"/>
                            <TextBlock Text="Split &amp; Save All Parts" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

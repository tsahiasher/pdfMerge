<Window x:Class="pdfMerge.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock PDF" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Custom Styles -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#0F172A">
        <StackPanel>
            <!-- HEADER -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Password Protected PDF" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtFileName" Text="document.pdf" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- EXPLANATION -->
            <TextBlock Text="This document is encrypted. Enter the password to unlock and import it into pdfMerge:"
                       FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <!-- PASSWORD INPUT CONTAINER -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Masked Password Input -->
                    <PasswordBox x:Name="PwdBox" Grid.Column="0"
                                 Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                                 Padding="8,6" FontSize="14" VerticalContentAlignment="Center"
                                 PasswordChanged="PwdBox_PasswordChanged"
                                 KeyDown="Input_KeyDown"/>

                    <!-- Plaintext Password Input (when Show Password is active) -->
                    <TextBox x:Name="TxtPlainPassword" Grid.Column="0"
                             Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                             Padding="8,6" FontSize="14" VerticalContentAlignment="Center"
                             Visibility="Collapsed"
                             TextChanged="TxtPlainPassword_TextChanged"
                             KeyDown="Input_KeyDown"/>

                    <!-- Show / Hide Password Toggle Button -->
                    <Button x:Name="BtnToggleVisibility" Grid.Column="1"
                            Click="BtnToggleVisibility_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,4" Cursor="Hand" ToolTip="Show/Hide Password"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtToggleIcon" Text="👁️" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ERROR MESSAGE (COLLAPSED BY DEFAULT) -->
            <TextBlock x:Name="TxtError" Text="Incorrect password. Please try again."
                       FontSize="12" Foreground="#EF4444" FontWeight="SemiBold"
                       Visibility="Collapsed" Margin="2,0,0,12"/>

            <!-- ACTION BUTTONS -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Skip / Cancel Button -->
                <Button Grid.Column="0" Click="BtnSkip_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#334155" Foreground="#CBD5E1"
                        HorizontalAlignment="Left" IsCancel="True">
                    <TextBlock Text="Skip File"/>
                </Button>

                <!-- Unlock Button -->
                <Button x:Name="BtnUnlock" Grid.Column="1" Click="BtnUnlock_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#0EA5E9" Foreground="White"
                        IsDefault="True" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔓 " FontSize="13"/>
                        <TextBlock x:Name="TxtUnlockBtnLabel" Text="Unlock PDF"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>

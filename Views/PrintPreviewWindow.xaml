<Window x:Class="pdfMerge.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Print Preview &amp; Settings" Height="750" Width="1080"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Icon="../pdfMerge.ico"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Modern Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="▼" FontSize="10" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,6,28,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#1E293B" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="250" Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button styles provided by shared Resources/AppStyles.xaml -->
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <!-- Left Print Controls Panel -->
            <ColumnDefinition Width="*"/>
            <!-- Right Live Preview Canvas -->
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: PRINT SETTINGS & OPTIONS -->
        <Border Grid.Column="0" Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- Settings Options -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖨️ " FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Print Document Settings" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Configure printer settings and review page preview." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- SETTINGS OPTIONS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- PRINTER SELECTION -->
                        <TextBlock Text="Printer Destination:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbPrinters" DisplayMemberPath="Name" Margin="0,0,0,16" SelectionChanged="CmbPrinters_SelectionChanged"/>

                        <!-- COPIES COUNT -->
                        <TextBlock Text="Copies:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16" Width="140" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCopies" Text="1" FontSize="14" FontWeight="Bold" Padding="8,4" TextAlignment="Center" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1.5"/>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Button Click="BtnCopyUp_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" Margin="0,0,0,2">
                                    <TextBlock Text="▲" FontSize="9"/>
                                </Button>
                                <Button Click="BtnCopyDown_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2">
                                    <TextBlock Text="▼" FontSize="9"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- COLOR MODE -->
                        <TextBlock Text="Color Mode:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,16">
                            <RadioButton x:Name="RdoColor" GroupName="ColorModeGroup" Content="Color (Full Color)" IsChecked="True" Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,6" Checked="RdoColor_Checked"/>
                            <RadioButton x:Name="RdoMonochrome" GroupName="ColorModeGroup" Content="Black &amp; White (Grayscale)" Foreground="#F8FAFC" FontSize="13" Checked="RdoMonochrome_Checked"/>
                        </StackPanel>

                        <!-- TWO-SIDED PRINTING (DUPLEX) -->
                        <TextBlock Text="Two-Sided Printing (Duplex):" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbDuplex" Margin="0,0,0,16">
                            <ComboBoxItem Content="Single-Sided (1 Sided)" IsSelected="True"/>
                            <ComboBoxItem Content="Flip on Long Edge (2 Sided)"/>
                            <ComboBoxItem Content="Flip on Short Edge (2 Sided)"/>
                        </ComboBox>

                        <!-- PRINT RANGE SELECTION -->
                        <TextBlock Text="Pages to Print:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton x:Name="RdoRangeAll" GroupName="PrintRangeGroup" Content="All Pages" IsChecked="True" Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,6" Checked="PrintRange_CheckedChanged"/>
                            <RadioButton x:Name="RdoRangeSelected" GroupName="PrintRangeGroup" Content="Selected Pages Only" Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,6" Checked="PrintRange_CheckedChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <RadioButton x:Name="RdoRangeCustom" GroupName="PrintRangeGroup" Content="Custom Range:" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center" Checked="PrintRange_CheckedChanged"/>
                                <TextBox x:Name="TxtCustomRange" Text="1-3" FontSize="13" Width="90" Padding="6,3" Margin="8,0,0,0" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1.5" TextChanged="TxtCustomRange_TextChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ACTION BUTTONS -->
                <StackPanel Grid.Row="2">
                    <Button x:Name="BtnPrintNow" Click="BtnPrintNow_Click" Style="{StaticResource SuccessBoldButtonStyle}" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🖨️ " FontSize="14"/>
                            <TextBlock Text="Print Document"/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch">
                        <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT PANEL: LIVE PRINT PREVIEW CANVAS -->
        <Border Grid.Column="1" Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Preview Toolbar / Page Navigation -->
                    <RowDefinition Height="*"/>
                    <!-- High-Resolution Live Image Canvas -->
                </Grid.RowDefinitions>

                <!-- PREVIEW TOOLBAR & PAGE NAVIGATION -->
                <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Print Preview" FontWeight="Bold" FontSize="14" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border Background="#334155" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPreviewRangeInfo" Text="3 Pages Total" FontSize="11" Foreground="#0EA5E9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Page Navigation (◀ Page X of Y ▶) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnPrevPage" Click="BtnPrevPage_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Text="◀ Prev"/>
                            </Button>

                            <TextBlock x:Name="TxtPageNavigation" Text="Page 1 of 3" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="6,0,10,0"/>

                            <Button x:Name="BtnNextPage" Click="BtnNextPage_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4">
                                <TextBlock Text="Next ▶"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LIVE PAGE PREVIEW DISPLAY CANVAS -->
                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="16" ClipToBounds="True">
                    <Grid x:Name="GridPreviewDisplay">
                        <!-- Rendered Page Image with Border Shadow -->
                        <Border BorderBrush="#334155" BorderThickness="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2">
                            <Image x:Name="ImgLivePagePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Loading Indicator -->
                        <StackPanel x:Name="PnlPreviewLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#0EA5E9" Margin="0,0,0,10"/>
                            <TextBlock Text="Rendering preview..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

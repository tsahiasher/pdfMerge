<Window x:Class="pdfMerge.Views.SignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sign PDF Page" Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Primary Button Style for Wizard -->
        <Style x:Key="WizardPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button Style for Wizard -->
        <Style x:Key="WizardSuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title Bar / Wizard Header -->
            <RowDefinition Height="*"/>
            <!-- Wizard Body -->
            <RowDefinition Height="Auto"/>
            <!-- Action Bar -->
        </Grid.RowDefinitions>

        <!-- WIZARD HEADER -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="Transparent" Margin="0,0,10,0">
                        <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWizardStepTitle" Text="Step 1 of 2: Draw Signature Placement Box" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtWizardStepSubtitle" Text="Click and drag your mouse on the page preview to specify where to place the signature." FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WIZARD BODY AREA -->
        <Grid Grid.Row="1">
            <!-- STEP 1: DRAW SIGNATURE PLACEMENT BOX -->
            <Grid x:Name="PnlStep1" Visibility="Visible">
                <Border Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid x:Name="GridStep1Canvas"
                          MouseLeftButtonDown="Step1Canvas_MouseLeftButtonDown"
                          MouseMove="Step1Canvas_MouseMove"
                          MouseLeftButtonUp="Step1Canvas_MouseLeftButtonUp"
                          Background="Transparent" Cursor="Cross">
                        
                        <!-- Page Preview Image -->
                        <Image x:Name="ImgPagePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Signature Placement Bounding Box Canvas -->
                        <Canvas x:Name="CnvPlacementOverlay" IsHitTestVisible="False">
                            <Rectangle x:Name="RectPlacement" Stroke="#0EA5E9" StrokeThickness="2.5" Fill="#330EA5E9" Visibility="Collapsed" RadiusX="3" RadiusY="3"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <!-- STEP 2: CREATE & SELECT SIGNATURE -->
            <Grid x:Name="PnlStep2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Drawing Canvas Container -->
                    <RowDefinition Height="Auto"/>
                    <!-- Saved Signatures Gallery -->
                </Grid.RowDefinitions>

                <!-- INK DRAWING CANVAS AREA -->
                <Border Grid.Row="0" Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Draw, Load, or Choose Signature Below:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                        
                        <!-- SIGNATURE AREA (Supports Drawing & Image Preview) -->
                        <Border BorderBrush="#0EA5E9" BorderThickness="2" CornerRadius="6" Width="600" Height="260" Background="White" ClipToBounds="True">
                            <Grid>
                                <!-- Image Signature Preview -->
                                <Image x:Name="ImgSignaturePreview" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
                                
                                <!-- Freehand Ink Drawing Canvas -->
                                <InkCanvas x:Name="InkSignCanvas" Background="Transparent" StrokeCollected="InkSignCanvas_StrokeCollected"/>
                            </Grid>
                        </Border>

                        <!-- Drawing Canvas Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Click="BtnUndoInk_Click" Style="{StaticResource {x:Type Button}}" Padding="12,6" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↩ " FontSize="12"/>
                                    <TextBlock Text="Undo"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnClearInk_Click" Style="{StaticResource {x:Type Button}}" Padding="12,6" Margin="0,0,12,0" Background="#334155" Foreground="White" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑 " FontSize="12"/>
                                    <TextBlock Text="Clear"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BtnLoadImageSignature_Click" Style="{StaticResource {x:Type Button}}" Padding="12,6" Margin="0,0,12,0" Background="#0EA5E9" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " FontSize="12"/>
                                    <TextBlock Text="Load Image Signature"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BtnSaveSignatureToLibrary_Click" Style="{StaticResource {x:Type Button}}" Padding="12,6" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 " FontSize="12"/>
                                    <TextBlock Text="Save Signature"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SAVED SIGNATURES LIBRARY -->
                <Border Grid.Row="1" Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Saved Signatures Library:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                        
                        <ListBox x:Name="LstSavedSignatures" Height="100" Background="Transparent" BorderThickness="0" SelectionChanged="LstSavedSignatures_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Height="80" Background="White" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="6" Margin="0,0,10,0" Padding="4">
                                        <Grid>
                                            <!-- Saved Signature Image -->
                                            <Image Source="{Binding Image}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            
                                            <!-- Delete Saved Signature Button -->
                                            <Button Click="BtnDeleteSavedSignature_Click" Style="{StaticResource DangerButtonStyle}" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Delete Saved Signature">
                                                <TextBlock Text="✕" FontSize="10"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- WIZARD BOTTOM ACTION BAR -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Button (Back) -->
                <Button x:Name="BtnBackStep" Grid.Column="0" Click="BtnBackStep_Click" Padding="16,8" Background="#334155" Foreground="White" BorderThickness="0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◀ " FontSize="12"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>

                <!-- Right Navigation Buttons (Continue / Finish / Cancel) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="BtnCancel_Click" Padding="16,8" Background="#334155" Foreground="#94A3B8" BorderThickness="0" Margin="0,0,10,0">
                        <TextBlock Text="Cancel"/>
                    </Button>

                    <Button x:Name="BtnContinueStep1" Click="BtnContinueStep1_Click" Style="{StaticResource WizardPrimaryButtonStyle}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Continue "/>
                            <TextBlock Text="▶"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnFinishStep2" Click="BtnFinishStep2_Click" Style="{StaticResource WizardSuccessButtonStyle}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✔ " FontSize="14"/>
                            <TextBlock Text="Apply Signature"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

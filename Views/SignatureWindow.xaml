<Window x:Class="pdfMerge.Views.SignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sign PDF Page" Height="740" Width="980"
        MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Primary Button Style for Wizard -->
        <Style x:Key="WizardPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button Style for Wizard -->
        <Style x:Key="WizardSuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title Bar / Wizard Header -->
            <RowDefinition Height="*"/>
            <!-- Wizard Body -->
            <RowDefinition Height="Auto"/>
            <!-- Action Bar -->
        </Grid.RowDefinitions>

        <!-- WIZARD HEADER -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="Transparent" Margin="0,0,10,0">
                        <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWizardStepTitle" Text="Step 1 of 2: Draw Signature Placement Box" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtWizardStepSubtitle" Text="Click and drag your mouse on the page preview to specify where to place the signature." FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WIZARD BODY AREA -->
        <Grid Grid.Row="1">
            <!-- STEP 1: DRAW SIGNATURE PLACEMENT BOX -->
            <Grid x:Name="PnlStep1" Visibility="Visible">
                <Border Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid x:Name="GridStep1Canvas"
                          MouseLeftButtonDown="Step1Canvas_MouseLeftButtonDown"
                          MouseMove="Step1Canvas_MouseMove"
                          MouseLeftButtonUp="Step1Canvas_MouseLeftButtonUp"
                          Background="Transparent" Cursor="Cross">
                        
                        <!-- Page Preview Image -->
                        <Image x:Name="ImgPagePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Signature Placement Bounding Box Canvas -->
                        <Canvas x:Name="CnvPlacementOverlay" IsHitTestVisible="False">
                            <Rectangle x:Name="RectPlacement" Stroke="#0EA5E9" StrokeThickness="2.5" Fill="#330EA5E9" Visibility="Collapsed" RadiusX="3" RadiusY="3"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <!-- STEP 2: CREATE & SELECT SIGNATURE (4 TABS DESIGN) -->
            <Grid x:Name="PnlStep2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Tab Navigation Header Bar -->
                    <RowDefinition Height="*"/>
                    <!-- Active Tab Content Area -->
                    <RowDefinition Height="Auto"/>
                    <!-- Saved Signatures Gallery -->
                </Grid.RowDefinitions>

                <!-- TAB NAVIGATION HEADER BAR -->
                <Border Grid.Row="0" Background="#182232" BorderBrush="#334155" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="8,4,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tab 1: Draw -->
                        <Button x:Name="BtnTabDraw" Grid.Column="0" Click="BtnTabDraw_Click" Padding="12,10" Background="Transparent" Foreground="#0EA5E9" BorderThickness="0,0,0,3" BorderBrush="#0EA5E9" FontWeight="Bold" FontSize="14" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✏️ " FontSize="13"/>
                                <TextBlock Text="Draw"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Type -->
                        <Button x:Name="BtnTabType" Grid.Column="1" Click="BtnTabType_Click" Padding="12,10" Background="Transparent" Foreground="#94A3B8" BorderThickness="0,0,0,0" BorderBrush="Transparent" FontWeight="SemiBold" FontSize="14" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⌨️ " FontSize="13"/>
                                <TextBlock Text="Type"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Upload -->
                        <Button x:Name="BtnTabUpload" Grid.Column="2" Click="BtnTabUpload_Click" Padding="12,10" Background="Transparent" Foreground="#94A3B8" BorderThickness="0,0,0,0" BorderBrush="Transparent" FontWeight="SemiBold" FontSize="14" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📤 " FontSize="13"/>
                                <TextBlock Text="Upload"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 4: Symbol -->
                        <Button x:Name="BtnTabSymbol" Grid.Column="3" Click="BtnTabSymbol_Click" Padding="12,10" Background="Transparent" Foreground="#94A3B8" BorderThickness="0,0,0,0" BorderBrush="Transparent" FontWeight="SemiBold" FontSize="14" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✔ " FontSize="13"/>
                                <TextBlock Text="Symbol"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- TAB CONTENTS CONTAINER -->
                <Border Grid.Row="1" Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="0,0,8,8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <!-- TAB 1: DRAW -->
                        <Grid x:Name="PnlTabDraw" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Draw Bar Controls: Thickness Slider Only -->
                                <Grid Width="600" Margin="0,0,0,10">
                                    <!-- Thickness Slider -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Thickness:" FontSize="12" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="SldThickness" Minimum="1" Maximum="15" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Width="140" VerticalAlignment="Center" ValueChanged="SldThickness_ValueChanged" ToolTip="Stroke Thickness (1-15px)"/>
                                        <TextBlock x:Name="TxtThicknessValue" Text="3px" FontSize="12" FontWeight="Bold" Foreground="#0EA5E9" VerticalAlignment="Center" Margin="8,0,0,0" Width="32"/>
                                    </StackPanel>
                                </Grid>

                                <!-- SIGNATURE DRAWING CANVAS -->
                                <Border BorderBrush="#0EA5E9" BorderThickness="2" CornerRadius="8" Width="600" Height="220" Background="White" ClipToBounds="True">
                                    <Grid x:Name="GridDrawCanvasArea">
                                        <InkCanvas x:Name="InkSignCanvas" Background="Transparent" StrokeCollected="InkSignCanvas_StrokeCollected"/>
                                    </Grid>
                                </Border>

                                <!-- Drawing Action Controls -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button Click="BtnUndoInk_Click" Style="{StaticResource {x:Type Button}}" Padding="12,6" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↩ " FontSize="12"/>
                                            <TextBlock Text="Undo"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnClearInk_Click" Style="{StaticResource {x:Type Button}}" Padding="12,6" Margin="0,0,12,0" Background="#334155" Foreground="White" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑 " FontSize="12"/>
                                            <TextBlock Text="Clear"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnSaveSignatureToLibrary_Click" Style="{StaticResource {x:Type Button}}" Padding="14,6" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " FontSize="12"/>
                                            <TextBlock Text="Save to Library"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 2: TYPE -->
                        <Grid x:Name="PnlTabType" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Width="600">
                                <!-- Text Input Box with "Type your signature" Label -->
                                <TextBlock Text="Type your signature" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtTypedSignature" Text="Signature Preview" FontSize="15" Padding="10,6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1.5" GotFocus="TxtTypedSignature_GotFocus" LostFocus="TxtTypedSignature_LostFocus" TextChanged="TxtTypedSignature_TextChanged" Margin="0,0,0,12"/>

                                <!-- Handwriting Font Pills Selector (Subtitle Text Removed) -->
                                <WrapPanel x:Name="PnlFontPills" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <!-- Dynamic Font Pill Buttons -->
                                </WrapPanel>

                                <!-- Live Signature Text Preview Container -->
                                <Border x:Name="BdrTypedPreview" BorderBrush="#0EA5E9" BorderThickness="2" CornerRadius="8" Width="600" Height="130" Background="White" ClipToBounds="True" Margin="0,0,0,12">
                                    <Grid x:Name="GridTypedPreview">
                                        <TextBlock x:Name="TxtTypedPreview" Text="Signature Preview" FontSize="38" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap"/>
                                    </Grid>
                                </Border>

                                <!-- Save Typed Signature to Library Button -->
                                <Button Click="BtnSaveSignatureToLibrary_Click" Style="{StaticResource {x:Type Button}}" Padding="14,6" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="12"/>
                                        <TextBlock Text="Save to Library"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 3: UPLOAD -->
                        <Grid x:Name="PnlTabUpload" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Width="600">
                                <!-- Drag & Drop Box -->
                                <Border x:Name="BdrUploadDropZone" AllowDrop="True" Drop="BdrUploadDropZone_Drop" DragOver="BdrUploadDropZone_DragOver" BorderBrush="#0EA5E9" BorderThickness="2" CornerRadius="8" Height="180" Background="#0F172A" Cursor="Hand" MouseLeftButtonDown="BdrUploadDropZone_MouseLeftButtonDown" Margin="0,0,0,10">
                                    <Grid>
                                        <!-- Image Preview (if image loaded) -->
                                        <Image x:Name="ImgUploadedPreview" Stretch="Uniform" Visibility="Collapsed" Margin="12"/>

                                        <!-- Upload Instructions -->
                                        <StackPanel x:Name="PnlUploadInstructions" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📤" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Drag &amp; drop signature image here or click to choose" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Supports PNG, JPG, BMP. Auto background transparency." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Action Buttons: Choose File & Save to Library -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Click="BtnLoadImageSignature_Click" Style="{StaticResource {x:Type Button}}" Padding="14,7" Margin="0,0,10,0" Background="#0EA5E9" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁 " FontSize="13"/>
                                            <TextBlock Text="Choose Image File"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnSaveSignatureToLibrary_Click" Style="{StaticResource {x:Type Button}}" Padding="14,7" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " FontSize="12"/>
                                            <TextBlock Text="Save to Library"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 4: SYMBOL (Save to Library Removed) -->
                        <Grid x:Name="PnlTabSymbol" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Width="600">
                                <TextBlock Text="Select Symbol Stamp:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Button x:Name="BtnSymbolCheck" Click="BtnSymbol_Click" Content="✔  Checkmark (V)" Tag="✔" Padding="14,7" Margin="0,0,8,0" Background="#0EA5E9" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                    <Button x:Name="BtnSymbolCross" Click="BtnSymbol_Click" Content="✖  Cross (X)" Tag="✖" Padding="14,7" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                    <Button x:Name="BtnSymbolStar" Click="BtnSymbol_Click" Content="★  Star" Tag="★" Padding="14,7" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                    <Button x:Name="BtnSymbolApproved" Click="BtnSymbol_Click" Content="APPROVED" Tag="APPROVED" Padding="14,7" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>

                                <!-- Symbol Live Preview Container (Black Only) -->
                                <Border x:Name="BdrSymbolPreview" BorderBrush="#0EA5E9" BorderThickness="2" CornerRadius="8" Width="600" Height="170" Background="White" ClipToBounds="True">
                                    <Grid x:Name="GridSymbolPreview">
                                        <TextBlock x:Name="TxtSymbolPreview" Text="✔" FontSize="72" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SAVED SIGNATURES LIBRARY -->
                <Border Grid.Row="2" Background="#182232" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Saved Signatures Library:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        
                        <ListBox x:Name="LstSavedSignatures" Height="85" Background="Transparent" BorderThickness="0" SelectionChanged="LstSavedSignatures_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150" Height="68" Background="White" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="6" Margin="0,0,10,0" Padding="4">
                                        <Grid>
                                            <Image Source="{Binding Image}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Click="BtnDeleteSavedSignature_Click" Style="{StaticResource DangerButtonStyle}" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Delete Saved Signature">
                                                <TextBlock Text="✕" FontSize="10"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- WIZARD BOTTOM ACTION BAR -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Button (Back) -->
                <Button x:Name="BtnBackStep" Grid.Column="0" Click="BtnBackStep_Click" Padding="16,8" Background="#334155" Foreground="White" BorderThickness="0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◀ " FontSize="12"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>

                <!-- Right Navigation Buttons (Continue / Finish / Cancel) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="BtnCancel_Click" Padding="16,8" Background="#334155" Foreground="#94A3B8" BorderThickness="0" Margin="0,0,10,0">
                        <TextBlock Text="Cancel"/>
                    </Button>

                    <Button x:Name="BtnContinueStep1" Click="BtnContinueStep1_Click" Style="{StaticResource WizardPrimaryButtonStyle}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Continue "/>
                            <TextBlock Text="▶"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnFinishStep2" Click="BtnFinishStep2_Click" Style="{StaticResource WizardSuccessButtonStyle}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✔ " FontSize="14"/>
                            <TextBlock Text="Apply Signature"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
